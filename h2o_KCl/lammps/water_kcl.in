# units real
# atom_style full
# boundary p f p 

# read_data water_kcl.data

# set type 1 charge -0.8476   # O
# set type 2 charge  0.4238   # H
# set type 3 charge  1.0      # K+
# set type 4 charge -1.0      # Cl-

package omp 4
suffix omp

units           real
atom_style      full
boundary        p p p       # Periodic in X (inlet/outlet), periodic in Y, fixed wall in Z

# Use slab correction for pseudo-2D geometry
# kspace_style    pppm 1e-4


read_data       water_kcl.data

# ============ FORCE FIELD ============
pair_style      lj/cut/coul/long 10.0

# Corrected type order: 1=CL, 2=H, 3=K, 4=O
pair_coeff      4 4 0.1553 3.166    
pair_coeff      2 2 0.0    0.0      
pair_coeff      3 3 0.1936 2.848    # K-K (Joung-Cheatham)
pair_coeff      1 1 0.0356 4.477    # Cl-Cl (Joung-Cheatham)

bond_style      harmonic
bond_coeff      1 450.0 1.0         # O-H

angle_style     harmonic
angle_coeff     1 55.0 109.47       # H-O-H

kspace_style    pppm 1e-4
# kspace_modify   slab 3.0

# ============ CHARGES ============
set type 4 charge -0.8476           # O
set type 2 charge  0.4238           # H
set type 3 charge  1.0              # K+
set type 1 charge -1.0              # Cl-

# ============ WALL (impenetrable, Z direction) ============
# Keep walls as fixes (not boundary)
# fix wall_lo all wall/lj93 ylo EDGE 0.1 3.0 10.0
# fix wall_hi all wall/reflect yhi EDGE

# ============ GROUPS ============
group oxygen    type 4
group hydrogen  type 2
group potassium type 3
group chloride  type 1

# ============ FIXES ============
fix fSHAKE all shake 1e-4 20 0 b 1 a 1
fix fNVT all nvt temp 300 300 100

# ============ CONCENTRATION PROFILES (Z direction = normal to wall) ============
compute chunks all chunk/atom bin/1d z lower 1.0 units box

fix conc_total   all        ave/chunk 100 100 10000 chunks density/number file conc_total.txt
fix conc_K       potassium  ave/chunk 100 100 10000 chunks density/number file conc_K.txt
fix conc_Cl      chloride   ave/chunk 100 100 10000 chunks density/number file conc_Cl.txt
fix conc_O       oxygen     ave/chunk 100 100 10000 chunks density/number file conc_O.txt

# ============ RUN ============
timestep        2.0
thermo          1000
dump            1 all atom 10000 traj.lammpstrj

# Energy minimization first
minimize 1e-4 1e-6 1000 10000

# Equilibration
run             50000

# Production
run             500000



############# About the script #################

## fix wall_lo all wall/lj93 ylo EDGE 0.1 3.0 10.0
# These are LJ wall parameters:

# 0.1 = epsilon (kcal/mol) — strength of wall interaction
# 3.0 = sigma (Å) — size/thickness of wall interaction
# 10.0 = cutoff (Å) — how far the wall influence reaches
 
## fix fNVT all nvt temp 300 300 100

# First 300 = start temperature (K)
# Second 300 = end temperature (K)
# 100 = damping parameter (fs) — how strongly temperature is controlled. 100 fs is standard.

## fix conc_K potassium ave/chunk 100 100 10000 chunks density/number file conc_K.txt

# 100 = Nevery — sample every 100 steps
# 100 = Nrepeat — repeat 100 times
# 10000 = Nfreq — write average to file every 10,000 steps
# density/number = outputs number density (atoms/Å³)
# Result = concentration of K⁺ in each Y slab → written to conc_K.txt