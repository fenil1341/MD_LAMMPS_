units           real
atom_style      full
boundary        p f p

pair_style      lj/cut/coul/cut 10.0
bond_style      harmonic
angle_style     harmonic

read_data       water_channel.data

pair_coeff      1 1   0.15535  3.16600
pair_coeff      2 2   0.00000  0.00000
pair_coeff      1 2   0.00000  0.00000

bond_coeff      1   1000.0   1.0
angle_coeff     1   1000.0   109.47

set type 1 charge -0.8476
set type 2 charge  0.4238

fix  SHAKE     all shake 0.0001 100 0 b 1 a 1
fix  WALL_TOP  all wall/reflect yhi EDGE
fix  WALL_BOT  all wall/reflect ylo EDGE

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

#  minimization ---
thermo          10
thermo_style    custom step temp press etotal
minimize        1.0e-4 1.0e-6 500 5000

#  NVT dynamics ---
fix  NVT  all nvt temp 300.0 300.0 100.0

thermo          50
thermo_style    custom step temp press etotal

dump         TRAJ  all atom 100 traj.lammpstrj
dump_modify  TRAJ  sort id

timestep   2.0
run        10000