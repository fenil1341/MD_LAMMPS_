package omp 4
suffix omp

units           real
atom_style      full
boundary        p p p

read_data       water_small.data

# ============ FORCE FIELD ============
pair_style      lj/cut/coul/long 10.0

# Type order from your .data file (check it!)
# Should be: 1=H, 2=O  or  1=O, 2=H
pair_coeff      1 1 0.0    0.0      # H-H
pair_coeff      2 2 0.1553 3.166    # O-O (SPC/E)

bond_style      harmonic
bond_coeff      1 450.0 1.0         # O-H

angle_style     harmonic
angle_coeff     1 55.0 109.47       # H-O-H

kspace_style    pppm 1e-4

# ============ CHARGES ============
set type 1 charge  0.4238           # H
set type 2 charge -0.8476           # O

# ============ FIXES ============
fix fSHAKE all shake 1e-4 20 0 b 1 a 1
# fix fNVT all nvt temp 300 300 100
fix mynve all nve

# ============ APPLIED FORCE (Poiseuille flow along X) ============
# fix fforce all addforce 0.001 0.0 0.0

# ============ RUN ============
timestep        0.001
thermo          1000
thermo_style custom step temp pe ke etotal press
dump            1 all atom 5000 traj_small.lammpstrj

compute myKE all ke
compute myPE all pe
variable KE equal c_myKE
variable PE equal c_myPE
fix energy all print 1000 "${KE} ${PE}" file energy.txt

# Minimization
minimize 1e-4 1e-6 1000 10000

# Equilibration
run             50000

# Production
# run             100000