log poiseuille.log

boundary p p f
units real
atom_style full
bond_style harmonic
angle_style harmonic
pair_style   lj/cut/coul/long 12.0
kspace_style pppm 1.0e-5
kspace_modify slab 3.0

read_data ../equilibrate.data
# read_data system.data

include ../parameters.inc
include ../groups.inc

fix mynve all nve
compute tliq fluid temp/partial 0 1 1
fix myber1 fluid temp/berendsen 300 300 100
fix_modify myber1 temp tliq
compute twall wall temp
fix myber2 wall temp/berendsen 300 300 100
fix_modify myber2 temp twall

fix myshk H2O shake 1.0e-5 200 0 b O-H a H-O-H
fix myspring wall spring/self 10.0 xyz

dump mydmp all atom 5000 poiseuille_dump.lammpstrj

thermo 1000
thermo_style custom step temp pe ke etotal press density

# fix mysf1 walltop setforce 0 NULL NULL
# fix mysf2 wallbot setforce 0 NULL NULL

fix myadf fluid addforce 1e-2 0.0 0.0

thermo_modify temp tliq


variable vcm_fluid equal vcm(fluid,x)
fix myat1 all ave/time 10 100 1000 v_vcm_fluid file vcm_fluid.dat

variable Nevery equal 10
variable Nrepeat equal 95000
variable Nfreq equal 1000000

compute cc1 H2O chunk/atom bin/1d z 0.0 1.0
compute cc2 wall chunk/atom bin/1d z 0.0 1.0
compute cc3 ions chunk/atom bin/1d z 0.0 1.0

fix myac1 H2O ave/chunk $(v_Nevery) $(v_Nrepeat) $(v_Nfreq) cc1 density/mass vx file water.profile_1A.dat
fix myac2 wall ave/chunk $(v_Nevery) $(v_Nrepeat) $(v_Nfreq) cc2 density/mass vx file wall.profile_1A.dat
fix myac3 ions ave/chunk $(v_Nevery) $(v_Nrepeat) $(v_Nfreq) cc3 density/mass vx file ions.profile_1A.dat

compute cc4 H2O chunk/atom bin/1d z 0.0 0.1
compute cc5 wall chunk/atom bin/1d z 0.0 0.1
compute cc6 ions chunk/atom bin/1d z 0.0 0.1

fix myac4 H2O ave/chunk $(v_Nevery) $(v_Nrepeat) $(v_Nfreq) cc4 density/mass vx file water.profile_0.1A.dat
fix myac5 wall ave/chunk $(v_Nevery) $(v_Nrepeat) $(v_Nfreq) cc5 density/mass vx file wall.profile_0.1A.dat
fix myac6 ions ave/chunk $(v_Nevery) $(v_Nrepeat) $(v_Nfreq) cc6 density/mass vx file ions.profile_0.1A.dat

timestep 1.0
run 2000000
write_data system.data